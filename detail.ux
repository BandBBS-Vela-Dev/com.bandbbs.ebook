<template>
	<div class="page">
	  <!-- scroll 组件：绑定 scrolltop 与 scrollbottom 事件 -->
	  <scroll id="scrollId"
		style="position: absolute; width: 212px; height: 520px;"
		scroll-y="{{true}}"
		@scroll="onScroll"
		@scrolltop="onScrollTop"
		@scrollbottom="onScrollBottom"
		@click="onTxtClick"
		onlongpress="onTxtLongPress"
		>

		<!-- 内容容器采用 flex 布局 -->
		<div id="contentContainer" style="position: absolute; padding:100px 0px; width:212px; flex-direction: column;">
		  <!-- 上方加载提示 -->
		  <text if="{{loadingPrev}}"
			style="width: 212px; text-align: center; color: #0D91FF; font-size: 24px;padding: 10px 0;">
			加载中...
		  </text>

		  <!-- 循环显示双页文本 -->
		  <text for="{{segments}}"
			id="{{'segment-' + $idx}}"
			style="width: 212px; text-align: left; color: rgba(255,255,255,{{opacity/100}}); font-size: {{fontSize}}px; font-weight: bold; line-height: {{lineHeight}}px; ">
			{{$item.text}}
		  </text>

		  <!-- 下方加载提示 -->
		  <text if="{{loadingNext}}"
			style="width: 212px; text-align: center; color: #0D91FF; font-size: 24px;padding: 10px 0;">
			加载中...
		  </text>
		</div>
	  </scroll>

	  <!-- 底部其他交互按钮 -->
	  <img show="{{showSetting}}" src="/common/images/mask_up.png" style="position: absolute; top: 0; left: 0;"/>
	  <img show="{{showSetting}}" src="/common/images/back.png" @click="back" style="position: absolute; left: 49.5px;top: 6.6px;width: 113px;height: 80px;"/>
	  <img show="{{showSetting}}" src="/common/images/mask_down.png" style="position: absolute; left: 0px; top: 389px;"/>
	  <img show="{{showSetting}}" src="/common/images/more.png" style="position: absolute; left: 49.5px;top: 433.8px;width: 113px;height: 80px;" @click="gotoSetting"/>

	  <!-- <text style="position: absolute; left: 0px; top: 240px; width: 212px; font-weight:bold; font-size:20px; color:blue;">
		{{debugOutput}}
	  </text> -->
	</div>
  </template>

  <script>
	import prompt from '@system.prompt'
	import file from '@system.file'
	import router from '@system.router'
  import storage from '../../common/storage.js'
	import brightness from '@system.brightness'

	// 每页文本字节数（实际读取字节数为 txtSizePage*2）
	var txtSizePage = 500;
	var allSize = 0;
	var SAVED_KEY = "EBOOK_SAVED";

    let autoInterval = null; // 自动翻页定时器

	export default {
	  private: {
		fPath: '',
		persent: 0,          // 阅读百分比（0～100）
		fontSize: 30,
		lineHeight: 34,
		pageHeigh: 520, // 与页面 scroll 高度保持一致，避免滚动步长不对齐导致跳页
		showSetting: true,
		loadingNext: false,   // 防止重复加载下一页
		loadingPrev: false,   // 防止重复加载上一页
		// 双页模式：segments 数组最多存放两个页面内容
		segments: [],
		debugOutput: "初始化中...",
		currentFileOffset: 0, // 当前顶部页面在文件中的起始偏移（字节）
		opacity: 100,
		swipe: 'column',
		auto: false,
		savedScrollOffset: 0,
		currentScrollTop: 0,
		isPaging: false, // 翻页锁，防止在翻页动画期间重复触发加载导致跳多页
		pagingTimer: null, // onScroll 去抖定时器
		lastSaveTime: 0,
		saveTimer: null,
		restoreApplied: false,
		relativePos: null,
		_savedLine: null,
		allowSave: false,
		skipNextSave: false,
		calibratedOnce: false,
		_savedCharOffset: null
	  },
	  protected: {
		cPath: '',
		name: ''  // 当前书籍名称或文件名，用作全局保存进度的键
	  },
	  onInit(){
		var that = this;
		// 初次启动提示（保持原有逻辑）
		storage.get({
		  key: 'EBOOK_TIPS',
		  success: function(data) {
			if(data != "1"){
			  storage.set({
				key: 'EBOOK_TIPS',
				value: '1',
				success: function(){
				  that.routerTo('info');
				}
			  });
			}
		  },
		  fail: function(){
			storage.set({
			  key: 'EBOOK_TIPS',
			  value: '1',
			  success: function(){
				that.routerTo('info');
			  }
			});
		  }
		});
	  },
	  onShow(){
		var that = this;
			// 修复：此前先 initReadFile 再异步获取字号，字号变化会导致文本重新排版 -> 视觉上“往前跳一段”
			// 调整为：先获取字号并计算行高/页面高度，再加载文件并恢复滚动位置。
			// 读取字号设置后再 initReadFile（唯一影响布局的是字号，透明度/翻页方式不会改变内容高度）
			storage.get({
			  key: 'EBOOK_FONT',
			  success: function(data){
				if(data){
				  that.fontSize = parseInt(data);
				  that.lineHeight = parseInt((-0.01)*(that.fontSize**2) + 1.62*that.fontSize - 3.23);
				} else {
				  storage.set({
					key: 'EBOOK_FONT',
					value: that.fontSize.toString()
				  });
				}
				that.pageHeigh = Math.floor(that.pageHeigh/that.lineHeight) * that.lineHeight;
				// 字号确定后再初始化阅读内容与位置恢复
				that.initReadFile();
			  },
			  fail: function(){
				// 获取失败也继续初始化
				that.initReadFile();
			  }
			});
			// 其余设置读取保持异步，不影响布局
			storage.get({
			  key: 'EBOOK_OPACITY',
			  success: function(data) {
				if (data) {
					that.opacity = parseInt(data)
					console.log("当前字号："+that.fontSize);
					console.log("当前透明度："+that.opacity);
				} else {
					storage.set({
						key: 'EBOOK_OPACITY',
						value: '100'
					});
					that.opacity = 100
				}
			  },
			})
			storage.get({
			  key: 'EBOOK_SWIPE',
			  success: function(data) {
				if (data) {
					that.swipe = data
				} else {
					storage.set({
						key: 'EBOOK_SWIPE',
						value: 'column'
					});
					that.swipe = 'column'
				}
			  },
			})
			storage.get({
			  key: 'EBOOK_AUTO',
				   success: (data) => {
				if(!data)return;
				const { speed, enable } = JSON.parse(data);
				if(enable)this.auto = speed;
			  }
			})
			// 不在这里调用 initReadFile，已移动到字号加载回调中
	  },
	  onScroll(e){
		const that = this;
		that.currentScrollTop = e.scrollY;
		if(this.skipNextSave) return; // 忽略恢复引发的滚动事件
		if(!this.allowSave){
			// 恢复阶段不触发保存，避免覆盖原位置
			return;
		}
		// 分页滚动对齐逻辑
		if(this.isPaging){
			if(this.pagingTimer) clearTimeout(this.pagingTimer);
			this.pagingTimer = setTimeout(function(){
				try{
					let scrollY = that.currentScrollTop || 0;
					let page = Math.round(scrollY / that.pageHeigh);
					let target = page * that.pageHeigh;
					that.$element("scrollId").scrollTo({ top: target, left: 0, behavior: 'instant' });
					that.savedScrollOffset = target;
					that.isPaging = false;
				}catch(e){}
			}, 160);
			return;
		}
		// 非分页滚动：节流自动保存
		this.scheduleAutoSave();
	  },
	  //【读取进度】从全局存储中恢复当前书籍的记录（格式 {"book1":{"p":..., "s":..., "o":0}, ...}）
	  initReadFile(){
		var that = this;
		this.allowSave = false; // 恢复完成前禁止保存
		this.restoreApplied = false;
		storage.get({
		  key: SAVED_KEY,
		  success: function(data){
			var globalData = {};
			if(data){ globalData = JSON.parse(data); }
			if(globalData[that.name] && (globalData[that.name].s || globalData[that.name].s === 0)){
			  const rec = globalData[that.name];
			  that.currentFileOffset = rec.s;
			  that.persent = rec.p || 0;
			  that.savedScrollOffset = rec.o;
			  that._savedRelative = (rec.r !== undefined)? rec.r : null;
			  if(rec.ls !== undefined && rec.ln !== undefined){
				that._savedLine = { ls: rec.ls, ln: rec.ln };
			  }
			  if(rec.charOffset !== undefined){
				that._savedCharOffset = rec.charOffset;
			  }
			} else {
			  that.currentFileOffset = 0;
			}
			that.readFile();
		  },
		  fail: function(){
			that.currentFileOffset = 0;
			that.readFile();
		  }
		});
	  },
	  readFile(){
		var that = this;
		var path = this.cPath;
		file.access({
		  uri: path,
		  success: function(){
			file.get({
			  uri: path,
			  success: function(data){
				allSize = data.length;
				// 从 currentFileOffset 开始加载初始双页内容
				that.loadInitialSegments();
			  },
			  fail: function(){ that.readError(); }
			});
		  },
		  fail: function(){ that.readError(); that.back(); }
		});
	  },
	  // 加载初始双页：先加载第一页，再加载第二页（如果存在）
	// 将恢复滚动的逻辑放在初始两页读取完成后，避免恢复时页面高度变化导致位置偏移
	  loadInitialSegments(){
		var that = this;
		this.readFileText(this.currentFileOffset, function(str, bytesRead){
		  that.segments = [{ text: str, offset: that.currentFileOffset, length: bytesRead }];
		  let nextOffset = that.currentFileOffset + bytesRead;
		  if(nextOffset < allSize){
			that.readFileText(nextOffset, function(str2, bytesRead2){
			  if(str2){
				that.segments.push({ text: str2, offset: nextOffset, length: bytesRead2 });
			  }
			  setTimeout(function(){
				try{
				  if(!that.restoreApplied){
					that.skipNextSave = true; // 恢复滚动导致的 onScroll 忽略保存
					if(that._savedCharOffset != null) that.applyCharOffsetRestore();
					else if(that._savedLine) that.applyLineRestore();
					else if(that._savedRelative != null) that.applyRelativePositionRestore();
					else that.$element("scrollId").scrollTo({ top: that.savedScrollOffset || 0, left: 0, behavior: 'instant' });
				  }
				  that.restoreApplied = true;
				  // 延迟允许保存，确保第二段高度稳定
				  setTimeout(()=>{ that.allowSave = true; },120);
				  setTimeout(()=>{ that.skipNextSave = false; },150);
				  // 调度二次校准，若首次恢复仍有偏差可再次对齐（仅执行一次）
				  setTimeout(()=>{ that.secondStageCalibration(); }, 220);
				  console.log("恢复进度（初始化后）："+that.savedScrollOffset+" line="+JSON.stringify(that._savedLine));
				}catch(e){}
			  }, 80);
			});
		  } else {
			setTimeout(function(){
			  try{
				if(!that.restoreApplied){
				  that.skipNextSave = true;
				  if(that._savedCharOffset != null) that.applyCharOffsetRestore();
				  else if(that._savedLine) that.applyLineRestore();
				  else if(that._savedRelative != null) that.applyRelativePositionRestore();
				  else that.$element("scrollId").scrollTo({ top: that.savedScrollOffset || 0, left: 0, behavior: 'instant' });
				}
				that.restoreApplied = true;
				setTimeout(()=>{ that.allowSave = true; },120);
				setTimeout(()=>{ that.skipNextSave = false; },150);
				setTimeout(()=>{ that.secondStageCalibration(); }, 220);
				console.log("恢复进度（单页）："+that.savedScrollOffset+" line="+JSON.stringify(that._savedLine));
			  }catch(e){}
			}, 80);
		  }
		});
	  },
	  // 不做翻页调整，仅追加一页（用于初始加载）
	  loadNextSegmentNoScroll(){
		var that = this;
		let lastSeg = that.segments[that.segments.length - 1];
		let newOffset = lastSeg.offset + lastSeg.length;
		if(newOffset >= allSize) return;
		that.readFileText(newOffset, function(str, bytesRead){
		  if(str){
			that.segments.push({ text: str, offset: newOffset, length: bytesRead });
			// 更新保存信息（顶部段代表当前进度）
			that.currentFileOffset = that.segments[0].offset;
			that.persent = parseInt(that.currentFileOffset * 100 / allSize);
			// that.saveData();
		  }
		});
	  },
	  //【读取文件文本】回调返回文本内容和实际读取的字节数
	  readFileText(readOffset, cb){
		if(readOffset >= allSize){
		  cb('', 0);
		  return;
		}
		var length = txtSizePage * 2;
		if(readOffset < 0){
		  length = length + readOffset;
		  readOffset = 0;
		}
		if((readOffset + length) >= allSize){
		  length = allSize - readOffset;
		}
		var that = this;
		file.readArrayBuffer({
		  uri: that.cPath,
		  position: readOffset,
		  length: length,
		  success: function(data){
			var str = '';
			for(var i = 0; i < data.buffer.length; i += 2){
			  str += String.fromCharCode(data.buffer[i+1]*256 + data.buffer[i]);
			}
			cb(str, length);
		  },
		  fail: function(){
			that.readError();
			cb('', 0);
		  }
		});
	  },
	  //【向下翻页】（scrollbottom 触发）
	  // 追加下一页内容；若双页数量超过 2，则移除顶部页面，并调用 scrollBy 向上偏移被移除页面高度
	  onScrollBottom(event){
		// 如果正在执行翻页动画或正在处理加载，则忽略重复触发
		if(this.isPaging) return;
		if(!this.loadingNext){
		  this.loadingNext = true;
		  this.loadNextSegment();
		}
	  },
	  loadNextSegment(){
        var that = this;
        let lastSeg = that.segments[that.segments.length - 1];
        let newOffset = lastSeg.offset + lastSeg.length;
        if(newOffset >= allSize){
          this.loadingNext = false;
          return;
        }
        this.readFileText(newOffset, function (str, bytesRead) {
          that.loadingNext = false;
          if(str){
            that.segments.push({ text: str, offset: newOffset, length: bytesRead });
            // 超过双页时：先测量即将被移除的顶部段落高度，再移除并滚动补偿，避免跳动
            if (that.segments.length > 2) {
              that.$element("segment-0").getBoundingClientRect({
                success: function(rect){
                  let removedHeight = rect.height;
                  // 数据移除
                  that.segments.shift();
                  // 位置补偿
                  that.$element("scrollId").scrollBy({
                    top: -removedHeight,
                    left: 0,
                    behavior: 'instant'
                  });
                },
                fail: function(){
                  // 测量失败仍移除以防堆积
                  that.segments.shift();
                }
              });
            }
            that.currentFileOffset = that.segments[0].offset;
            that.persent = parseInt(that.currentFileOffset * 100 / allSize);
            // 延迟由滚动事件统一保存，避免立即保存导致重进定位偏前
          }
        });
	  },
	  //【向上翻页】（scrolltop 触发）
	  // 预先加载上一页内容，并插入到数组头部；如果超过两页，则移除底部页面，并调用 scrollBy 向下偏移新插入页面高度
	  onScrollTop(event){
		// 同样加锁避免重复触发
		if(this.isPaging) return;
		if(!this.loadingPrev && this.currentFileOffset > 0){
		  this.loadingPrev = true;
		  this.loadPrevSegment();
		}
	  },
	  loadPrevSegment(){
		var that = this;
		let firstSeg = that.segments[0];
		let newOffset = firstSeg.offset - txtSizePage * 2;
		if(newOffset < 0) newOffset = 0;
		if(firstSeg.offset <= 0){
		  this.loadingPrev = false;
		  return;
		}
  		  this.readFileText(newOffset, function (str, bytesRead) {
		  that.loadingPrev = false;
		  if(str){
			that.segments.unshift({ text: str, offset: newOffset, length: bytesRead });
			that.$element("segment-0").getBoundingClientRect({
			  success: function(rect){
				let insertedHeight = rect.height;
				that.$element("scrollId").scrollBy({
				  top: insertedHeight,
				  left: 0,
				  behavior: 'instant'
				});
			  },
			  fail: function(){}
			});
			if(that.segments.length > 2){ that.segments.pop(); }
			that.currentFileOffset = that.segments[0].offset;
			that.persent = parseInt(that.currentFileOffset * 100 / allSize);
			// 滚动结束后由节流保存
		  }
		});
	  },
	  readError(){
		prompt.showToast({
		  message: '文件读取失败',
		  duration: 2000
		});
	  },
	  gotoSetting(){
		this.saveData();
		setTimeout(() => {
			router.push({
				uri: '/pages/detailsetting',
				params: { cPath: this.cPath, name: this.name, size: allSize }
			});
		}, 200);
	  },
	  //【保存进度】只更新当前书籍对应的记录，格式 {"book1":{"p":..., "s":..., "o":0}, ...}
	  saveData(rel){
		var that = this;
		const lineInfo = this._savedLine || { ls: 0, ln: 0 };
		const charOffset = this._savedCharOffset || this.currentFileOffset;
		// 兼容旧阅读器：保留已有记录(如 bookmarks)并只更新进度相关字段
		storage.get({
		  key: SAVED_KEY,
		  success: function(data){
			var globalData = {};
			if(data){
			  try { globalData = JSON.parse(data); } catch(e){ globalData = {}; }
			}
			let rec = globalData[that.name] || {};
			// 旧版字段（保持）
			rec.s = that.currentFileOffset; // 顶部段起始偏移
			rec.p = that.persent;           // 百分比（旧逻辑依赖）
			rec.o = that.currentScrollTop;  // 垂直滚动像素位置（旧逻辑）
			// 新版精细定位字段
			rec.r = (rel !== undefined ? rel : that.relativePos); // 相对比例 0~2
			rec.ls = lineInfo.ls;           // 段索引
			rec.ln = lineInfo.ln;           // 段内行号（行索引-按行高）
			rec.charOffset = charOffset;    // 精确字符偏移(估算)
			// 其他如 bookmarks / 扩展字段不动
			globalData[that.name] = rec;
			storage.set({ key: SAVED_KEY, value: JSON.stringify(globalData) });
		  },
		  fail: function(){
			var globalData = {};
			let rec = {};
			rec.s = that.currentFileOffset;
			rec.p = that.persent;
			rec.o = that.currentScrollTop;
			rec.r = (rel !== undefined ? rel : that.relativePos);
			rec.ls = lineInfo.ls;
			rec.ln = lineInfo.ln;
			rec.charOffset = charOffset;
			globalData[that.name] = rec;
			storage.set({ key: SAVED_KEY, value: JSON.stringify(globalData) });
		  }
		});
		console.log('保存数据-charOffset: '+ this.name + ' offset=' + charOffset + ' ls=' + lineInfo.ls + ' ln=' + lineInfo.ln + ' r=' + (rel !== undefined ? rel : this.relativePos));
	  },
	  onHide(){
		// 先保存进度
		try{ this.saveData(); }catch(e){}
		// 处理自动翻页定时器
		if(autoInterval){
			clearInterval(autoInterval);
			autoInterval = null;
			prompt.showToast({
					message: '已关闭自动翻页',
					duration: 2000
				});
			brightness.setKeepScreenOn({ keepScreenOn: false });
		}
	  },
	  onDestroy(){
		if (this.auto) {
			clearInterval(autoInterval);
			autoInterval = null;
			brightness.setKeepScreenOn({ keepScreenOn: false });
		}
		// 清理 onScroll 去抖定时器
		if(this.pagingTimer){
			clearTimeout(this.pagingTimer);
			this.pagingTimer = null;
		}
	  },
	  onBackPress(){
		this.back()
		return true;
	  },
	  back(){
		this.saveData();
		setTimeout(() => {
			router.back();
		}, 200);
	  },
	  routerTo(url){
		router.push({
		  uri: '/pages/' + url
		});
	  },
  	onTxtClick(event) {
		// console.log(JSON.stringify(event));
		if (this.swipe === 'column') {
			this.showSetting = !this.showSetting;
		} else {
			if (this.showSetting) {
				this.showSetting = false;
			} else {
				if (event.offsetY <= 178) {
					this.lastPage();
				} else if (event.offsetY <= 342) {
					this.showSetting = !this.showSetting;
				} else {
					this.nextPage();
				}
			}

		}
	},
	onTxtLongPress(event) {
  		if (this.auto) {
			if(autoInterval){
				clearInterval(autoInterval);
				autoInterval = null;
				prompt.showToast({
					message: '已关闭自动翻页',
					duration: 2000
				});
				brightness.setKeepScreenOn({ keepScreenOn: false });
				return;
			}

			autoInterval = setInterval(() => {
				this.nextPage();
				}, this.auto*1000);
			prompt.showToast({
				message: '已开启自动翻页',
				duration: 2000
			});
			brightness.setKeepScreenOn({ keepScreenOn: true });
		}
	},
	onTxtSwipe(event){
		if(event.direction === 'right'){
		  this.back();
		}
  	},
	lastPage() {
		// 启动分页锁，防止在动画期间触发多次加载
		this.isPaging = true;
		this.$element("scrollId").scrollBy({
			top: - this.pageHeigh,
			left: 0,
			behavior: 'smooth'
		  });
		// 预计动画时长后释放锁（延长为 600ms 以适配较慢设备）
		setTimeout(() => { this.isPaging = false; }, 600);
	},
	nextPage() {
		// 启动分页锁，防止在动画期间触发多次加载
		this.isPaging = true;
		this.$element("scrollId").scrollBy({
			top: this.pageHeigh,
			left: 0,
			behavior: 'smooth'
		  });
		// 预计动画时长后释放锁（延长为 600ms 以适配较慢设备）
		setTimeout(() => { this.isPaging = false; }, 600);
	  },
	  scheduleAutoSave(){
		if(!this.allowSave) return; // 未完成恢复不保存
		if(this.saveTimer){ clearTimeout(this.saveTimer); }
		this.saveTimer = setTimeout(()=>{
			this.saveTimer = null;
			this.computeAndSaveLinePosition();
		}, 400);
	  },
	  // 行级保存：计算当前滚动位于第几段、第几行（行号按行高直接取整，更稳定）
	  computeAndSaveLinePosition(){
		const paddingTop = 100;
		const scrollTop = this.currentScrollTop;
		this.$element('segment-0').getBoundingClientRect({
		  success: (r0) => {
			const h0 = r0.height;
			this.$element('segment-1').getBoundingClientRect({
			  success: (r1) => { this._finishLineSave(scrollTop, paddingTop, h0, r1.height); },
			  fail: () => { this._finishLineSave(scrollTop, paddingTop, h0, 0); }
			});
		  },
		  fail: () => { this.computeAndSaveRelativePosition(); }
		});
	  },
	  // 新的行保存逻辑：使用 inside 像素 / lineHeight 直接得到行索引，减少高度变化造成的比例误差
	  _finishLineSave(scrollTop, paddingTop, h0, h1){
		if(!this.lineHeight){ // 兜底
		  this.computeAndSaveRelativePosition();
		  return;
		}
		let inside = scrollTop - paddingTop;
		if(inside < 0) inside = 0;
		let segIdx = 0; 
		let lineInSeg = 0;
		let charOffset = this.currentFileOffset;
		const seg0Lines = this.lineHeight? Math.max(1, Math.round(h0 / this.lineHeight)) : 1;
		const seg1Lines = this.lineHeight? Math.max(1, Math.round(h1 / this.lineHeight)) : 1;

		if(inside <= h0 || h0 === 0){
		  segIdx = 0;
		  const pixelInSeg = Math.min(Math.max(inside,0), h0);
		  lineInSeg = Math.floor(pixelInSeg / this.lineHeight);
		  const ratio0 = h0? (pixelInSeg / h0) : 0; // 用于估算字符偏移
		  charOffset += Math.round(ratio0 * (this.segments[0]? this.segments[0].length : 0));
		}else{
		  segIdx = 1;
		  let rest = inside - h0;
		  if(rest < 0) rest = 0;
		  const pixelInSeg = Math.min(rest, h1);
		  lineInSeg = Math.floor(pixelInSeg / this.lineHeight);
		  const ratio1 = h1? (pixelInSeg / h1) : 0;
		  charOffset += (this.segments[0]? this.segments[0].length : 0) + Math.round(ratio1 * (this.segments[1]? this.segments[1].length : 0));
		}
		// 行索引越界修正
		if(segIdx===0 && lineInSeg >= seg0Lines) lineInSeg = seg0Lines -1;
		if(segIdx===1 && lineInSeg >= seg1Lines) lineInSeg = seg1Lines -1;
		this._savedLine = { ls: segIdx, ln: lineInSeg };
		this._savedCharOffset = charOffset;
		this._finishRelativeSave(scrollTop, paddingTop, h0, h1);
	  },
	  applyLineRestore(){
		const paddingTop = 100;
		if(!this._savedLine) return;
		const { ls, ln } = this._savedLine;
		this.$element('segment-0').getBoundingClientRect({
		  success: (r0) => {
			let h0 = r0.height;
			this.$element('segment-1').getBoundingClientRect({
			  success: (r1) => { this._applyLine(ls, ln, h0, r1.height, paddingTop); },
			  fail: () => { this._applyLine(ls, ln, h0, 0, paddingTop); }
			});
		  },
		  fail: () => { if(this._savedRelative!=null) this.applyRelativePositionRestore(); }
		});
	  },
	  // 按行索引恢复：直接使用 lineIndex * lineHeight，避免比例反推误差
	  _applyLine(ls, ln, h0, h1, paddingTop){
		if(!this.lineHeight){ this.applyRelativePositionRestore(); return; }
		let target = paddingTop;
		if(ls === 0){
		  const maxIndex0 = this.lineHeight? Math.max(0, Math.floor(h0 / this.lineHeight) - 1) : 0;
		  const useIdx = Math.min(ln, maxIndex0);
		  target += useIdx * this.lineHeight;
		}else{
		  target += h0; // 先跳过第一段
		  const maxIndex1 = this.lineHeight? Math.max(0, Math.floor(h1 / this.lineHeight) - 1) : 0;
		  const useIdx = Math.min(ln, maxIndex1);
		  target += useIdx * this.lineHeight;
		}
		this.$element('scrollId').scrollTo({ top: target, left:0, behavior:'instant' });
		this.currentScrollTop = target;
	  },
	  applyCharOffsetRestore(){
		const offset = this._savedCharOffset;
		if(offset == null) return;
		const paddingTop = 100;
		let target = paddingTop;
		// 遍历段落，找到包含该偏移的段落并计算滚动位置
		for(let i = 0; i < this.segments.length; i++){
		  const seg = this.segments[i];
		  if(offset >= seg.offset && offset < (seg.offset + seg.length)){
			const charIndex = offset - seg.offset;
			const ratio = seg.length ? (charIndex / seg.length) : 0;
			const segHeight = i === 0 ? this.$element('segment-0').getBoundingClientRect().height : this.$element('segment-1').getBoundingClientRect().height;
			target += ratio * segHeight;
			break;
		  }
		  if(i === 0) target += this.$element('segment-0').getBoundingClientRect().height;
		}
		this.$element('scrollId').scrollTo({ top: target, left: 0, behavior: 'instant' });
		this.currentScrollTop = target;
	  },
	  computeAndSaveRelativePosition(){
		const paddingTop = 100; // 与模板中 contentContainer padding 一致
		const scrollTop = this.currentScrollTop;
		let h0 = 0, h1 = 0;
		// 测量第一段高度
		this.$element('segment-0').getBoundingClientRect({
		  success: (r0) => {
			h0 = r0.height;
			// 测量第二段（可能不存在）
			this.$element('segment-1').getBoundingClientRect({
			  success: (r1) => { h1 = r1.height; this._finishRelativeSave(scrollTop, paddingTop, h0, h1); },
			  fail: () => { this._finishRelativeSave(scrollTop, paddingTop, h0, 0); }
			});
		  },
		  fail: () => { this.saveData(); }
		});
	  },
	  _finishRelativeSave(scrollTop, paddingTop, h0, h1){
		let inside = scrollTop - paddingTop;
		if(inside < 0) inside = 0;
		let r = 0;
		if(inside <= h0 || h0 === 0){
		  r = h0? (inside / h0) : 0;
		} else {
		  let rest = inside - h0;
		  if(h1 <= 0){ r = 1; }
		  else r = 1 + rest / h1; // 1~2 表示第二段比例
		}
		this.relativePos = r;
		this.saveData(r);
	  },
	  applyRelativePositionRestore(){
		const paddingTop = 100;
		let r = this._savedRelative;
		if(r == null){ return; }
		this.$element('segment-0').getBoundingClientRect({
		  success: (r0) => {
			let h0 = r0.height;
			this.$element('segment-1').getBoundingClientRect({
			  success: (r1) => { this._applyR(r, h0, r1.height, paddingTop); },
			  fail: () => { this._applyR(r, h0, 0, paddingTop); }
			});
		  },
		  fail: () => {
			// 回退到旧逻辑
			this.$element("scrollId").scrollTo({ top: this.savedScrollOffset || 0, left:0, behavior:'instant'});
		  }
		});
	  },
	  _applyR(r, h0, h1, paddingTop){
		let target = 0;
		if(r <= 1){
		  target = paddingTop + r * h0;
		}else{
		  target = paddingTop + h0 + (h1>0 ? (r-1)*h1 : 0);
		}
		this.$element('scrollId').scrollTo({ top: target, left:0, behavior:'instant' });
		this.currentScrollTop = target;
	  },
	  // 二次校准：在页面渲染稳定后再按当前段高/比例重新对齐一次，避免首次渲染测量误差导致回到段首
	  secondStageCalibration(){
		if(this.calibratedOnce) return;
		this.calibratedOnce = true;
		// 在校准期间禁止保存，防止误覆盖
		this.skipNextSave = true;
		this.allowSave = false;
		const that = this;
		setTimeout(()=>{
			// 优先按首字符偏移恢复；若失败则按行/比例恢复
			if(that._savedCharOffset != null){
				that.applyCharOffsetRestore();
			} else if(that._savedLine){
				that.applyLineRestore();
			} else if(that._savedRelative != null){
				that.applyRelativePositionRestore();
			}
			// 轻微延时后恢复保存能力
			setTimeout(()=>{
				that.skipNextSave = false;
				that.allowSave = true;
			}, 160);
		}, 120);
	  }
	}
  </script>

<style>
.page {
	width: 212px;
	height: 520px;
	background-color: #000000;
}
</style>